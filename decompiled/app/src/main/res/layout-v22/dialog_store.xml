<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/dialog_store_1_border"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:padding="0dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/cat_iv"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="3dp"
            android:src="@drawable/cat"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="H,423:428"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintWidth_max="150dp"
            app:layout_constraintWidth_percent="0.3"/>
        <LinearLayout
            android:id="@+id/header_ll"
            android:background="@drawable/dialog_store_1_border_filled2"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:textSize="@dimen/textSizeM1"
                android:textStyle="bold"
                android:textColor="@color/white_alpha_0"
                android:id="@+id/txtTitle"
                android:paddingLeft="10dp"
                android:paddingTop="5dp"
                android:paddingRight="5dp"
                android:paddingBottom="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/store_1_title"
                android:paddingStart="10dp"
                android:paddingEnd="5dp"/>
            <ImageView
                android:id="@+id/btn1"
                android:paddingTop="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/coinb3_xl"
                android:scaleType="center"
                android:alpha="0.7"/>
        </LinearLayout>
        <TextView
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textSize="@dimen/textSizeM2"
            android:textStyle="normal"
            android:id="@+id/features_tv"
            android:padding="10dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/store_1_desc"
            android:singleLine="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/header_ll"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/option_container_ll"
            android:visibility="invisible"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/features_tv">
            <com.daaw.avee.comp.InAppBilling.StoreItem
                android:id="@+id/item_0_ll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <View
                android:background="@color/store_1_feature_light"
                android:layout_width="1dp"
                android:layout_height="match_parent"/>
            <com.daaw.avee.comp.InAppBilling.StoreItem
                android:id="@+id/item_1_ll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <View
                android:background="@color/store_1_feature_light"
                android:layout_width="1dp"
                android:layout_height="match_parent"/>
            <com.daaw.avee.comp.InAppBilling.StoreItem
                android:id="@+id/item_2_ll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
        </LinearLayout>
        <View
            android:id="@+id/bottom_border"
            android:background="@color/store_1_feature_light"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            app:layout_constraintTop_toBottomOf="@+id/option_container_ll"/>
        <TextView
            android:id="@+id/legacy_warning_tv"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/store_legacy_warning"
            android:paddingHorizontal="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/bottom_border"/>
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:id="@+id/try_3_days_free"
            android:background="@drawable/border_item_background_regular"
            android:paddingLeft="10dp"
            android:paddingTop="5dp"
            android:paddingRight="10dp"
            android:paddingBottom="5dp"
            android:focusable="true"
            android:visibility="visible"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/store_try_3_days_free"
            android:paddingHorizontal="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/legacy_warning_tv"/>
        <Button
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:textSize="@dimen/textSizeM0"
            android:textStyle="bold"
            android:textColor="@color/dialog_store_button_text"
            android:gravity="center"
            android:id="@+id/btnBuy"
            android:background="@drawable/dialog_store_button"
            android:paddingLeft="20dp"
            android:paddingTop="10dp"
            android:paddingRight="20dp"
            android:paddingBottom="10dp"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:tint="@color/text_color_m1"
            android:text="@string/store_1_buy"
            android:paddingHorizontal="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/try_3_days_free"/>
        <TextView
            android:textSize="@dimen/textSizeM4"
            android:paddingLeft="10dp"
            android:paddingTop="15dp"
            android:paddingRight="10dp"
            android:paddingBottom="15dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:tint="@color/text_color_m3"
            android:text="@string/store_disclaimer"
            android:paddingHorizontal="10dp"
            android:paddingVertical="15dp"
            app:layout_constraintEnd_toStartOf="@+id/cat_iv"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnBuy"
            app:layout_constraintWidth_max="220dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
