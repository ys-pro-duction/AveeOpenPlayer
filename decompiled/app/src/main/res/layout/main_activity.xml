<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/compose_view"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.daaw.avee.CustomRelativeLayout
        android:id="@+id/rootView"
        android:background="@color/black"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.daaw.avee.CustomViewPager
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <View
            android:id="@+id/viewStatusBarBg"
            android:background="#00000000"
            android:layout_width="match_parent"
            android:layout_height="@dimen/status_bar_height"
            android:layout_alignParentTop="true"/>
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:layout_below="@+id/viewStatusBarBg"
            app:contentInsetLeft="0dp"
            app:contentInsetStart="0dp"
            app:contentInsetStartWithNavigation="8dp"
            app:navigationIcon="@drawable/ic_menu5"
            app:popupTheme="@style/ThemeOverlay.MyPopup"
            app:subtitleTextAppearance="@style/RobotoTextViewStyleM2Light"
            app:titleTextAppearance="@style/RobotoTextViewStyleM2"/>
        <com.daaw.avee.MediaControlsView
            android:id="@+id/media_control_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </com.daaw.avee.CustomRelativeLayout>
    <LinearLayout
        android:layout_gravity="start"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <com.google.android.material.navigation.NavigationView
            android:id="@+id/nav_view"
            android:background="@color/white_alpha_1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:headerLayout="@layout/nav_header"
            app:itemIconTint="?attr/containerFG"
            app:itemTextAppearance="?android:attr/textAppearanceSmall"
            app:itemTextColor="?attr/containerFG"
            app:menu="@menu/drawer_main_menu"/>
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/drawer_compose_view"
            android:background="#ffffff"
            android:layout_width="300dp"
            android:layout_height="55dp"/>
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
