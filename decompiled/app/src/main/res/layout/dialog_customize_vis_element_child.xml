<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center_horizontal"
    android:id="@+id/elementRoot"
    android:background="?attr/listItemBackground"
    android:padding="0dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/textSizeM3"
        android:textColor="@color/white_alpha_2"
        android:gravity="center_vertical"
        android:id="@+id/title"
        android:padding="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:layout_alignParentTop="true"/>
    <androidx.appcompat.widget.AppCompatSpinner
        android:textSize="@dimen/textSizeM3"
        android:gravity="right"
        android:id="@+id/spinnerType"
        android:padding="0dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="0dp"
        android:layout_toRightOf="@+id/title"
        android:layout_alignTop="@+id/title"
        android:layout_alignBottom="@+id/title"
        android:layout_alignParentRight="true"
        android:textAlignment="center"/>
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/linearLayoutContent"
        android:paddingLeft="25dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:layout_below="@+id/title"/>
    <View
        android:orientation="vertical"
        android:id="@+id/row1Gap"
        android:background="@color/white_alpha_25"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_width="0.5dp"
        android:layout_height="0dp"
        android:layout_marginLeft="16dp"
        android:layout_marginBottom="4dp"
        android:layout_alignTop="@+id/linearLayoutContent"
        android:layout_alignBottom="@+id/linearLayoutContent"/>
</RelativeLayout>
