<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:recyclerviewfastscroller="http://schemas.android.com/apk/res-auto"
    android:background="?attr/containerBackground"
    android:paddingLeft="0dp"
    android:paddingRight="0dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/viewStatusBarBg"
        android:background="?attr/colorPrimary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/status_bar_height"
        android:layout_alignParentTop="true"/>
    <View
        android:id="@+id/viewActionBarBg"
        android:background="?attr/colorPrimary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/actionbar_height"
        android:layout_below="@+id/viewStatusBarBg"/>
    <View
        android:id="@+id/viewActionBarBgSkin"
        android:background="#00000000"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="@dimen/actionbar_height"
        android:layout_below="@+id/viewStatusBarBg"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewItems"
        android:background="@color/transparent"
        android:paddingLeft="0dp"
        android:paddingRight="0dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_below="@+id/viewActionBarBg"
        android:layout_alignParentBottom="true"
        recyclerviewfastscroller:fastScrollEnabled="true"
        recyclerviewfastscroller:fastScrollHorizontalThumbDrawable="@drawable/listview_thumb_drawable"
        recyclerviewfastscroller:fastScrollHorizontalTrackDrawable="@drawable/listview_line_drawable"
        recyclerviewfastscroller:fastScrollVerticalThumbDrawable="@drawable/listview_thumb_drawable"
        recyclerviewfastscroller:fastScrollVerticalTrackDrawable="@drawable/listview_line_drawable"/>
    <View
        android:background="@drawable/actionbar_shadow_2x"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_below="@+id/viewActionBarBg"/>
</RelativeLayout>
