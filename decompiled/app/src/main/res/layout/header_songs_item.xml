<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:ads="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/containerBackgroundDark"
    android:padding="0dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <HorizontalScrollView
        android:padding="0dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="horizontal"
            android:padding="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:id="@+id/group1"
                android:background="?android:attr/selectableItemBackground"
                android:padding="4dp"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="48dp">
                <TextView
                    android:textSize="10sp"
                    android:textColor="?attr/containerFGw"
                    android:id="@+id/txt1"
                    android:clickable="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/libItemAction_playAll"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"/>
                <ImageView
                    android:id="@+id/btn1"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_playlist4_play3"
                    android:scaleType="center"
                    android:tint="?attr/containerFG"
                    android:layout_above="@+id/txt1"
                    android:layout_centerHorizontal="true"
                    android:color="@color/text_color_m1"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/group2"
                android:background="?android:attr/selectableItemBackground"
                android:padding="4dp"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="48dp">
                <TextView
                    android:textSize="10sp"
                    android:textColor="?attr/containerFGw"
                    android:id="@+id/txt2"
                    android:clickable="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/libItemAction_enqueueAll"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"/>
                <ImageView
                    android:id="@+id/btn2"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_playlist4_plus3"
                    android:scaleType="center"
                    android:tint="?attr/containerFG"
                    android:layout_above="@+id/txt2"
                    android:layout_centerHorizontal="true"
                    android:color="@color/text_color_m1"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/group5"
                android:background="?android:attr/selectableItemBackground"
                android:padding="4dp"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="48dp">
                <TextView
                    android:textSize="10sp"
                    android:textColor="?attr/containerFGw"
                    android:id="@+id/txt5"
                    android:clickable="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/toolbar_Sort"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"/>
                <ImageView
                    android:id="@+id/btn5"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_sort3"
                    android:scaleType="center"
                    android:tint="?attr/containerFG"
                    android:layout_above="@+id/txt5"
                    android:layout_centerHorizontal="true"
                    android:color="@color/text_color_m1"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/group7"
                android:background="?android:attr/selectableItemBackground"
                android:padding="4dp"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="48dp">
                <TextView
                    android:textSize="10sp"
                    android:textColor="?attr/containerFGw"
                    android:id="@+id/txt7"
                    android:clickable="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/toolbar_ViewLayout"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"/>
                <ImageView
                    android:id="@+id/btn7"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_layout"
                    android:scaleType="center"
                    android:tint="?attr/containerFG"
                    android:layout_above="@+id/txt7"
                    android:layout_centerHorizontal="true"
                    android:color="@color/text_color_m1"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/group6"
                android:background="?android:attr/selectableItemBackground"
                android:padding="4dp"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="48dp">
                <TextView
                    android:textSize="10sp"
                    android:textColor="?attr/containerFGw"
                    android:id="@+id/txt6"
                    android:clickable="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/toolbar_showAlbumArtInstead"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"/>
                <ImageView
                    android:id="@+id/btn6"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_visual3"
                    android:scaleType="center"
                    android:tint="?attr/containerFG"
                    android:layout_above="@+id/txt6"
                    android:layout_centerHorizontal="true"
                    android:color="@color/text_color_m1"/>
            </RelativeLayout>
        </LinearLayout>
    </HorizontalScrollView>
    <include layout="@layout/ad_container"/>
</LinearLayout>
