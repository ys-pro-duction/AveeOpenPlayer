<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_horizontal"
    android:id="@+id/elementRoot"
    android:background="?attr/listItemBackground"
    android:padding="0dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/textSizeM3"
        android:textColor="@color/white_alpha_2"
        android:gravity="center_vertical"
        android:id="@+id/title"
        android:padding="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="40dp"
        android:text=""
        android:layout_toLeftOf="@+id/txtValue"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"/>
    <TextView
        android:textSize="@dimen/textSizeM3"
        android:textColor="@color/white_alpha_2"
        android:gravity="center_vertical"
        android:id="@+id/txtValue"
        android:padding="8dp"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:text=""
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"/>
    <View
        android:orientation="horizontal"
        android:id="@+id/lineBarBgX"
        android:background="@color/white_alpha_3"
        android:layout_width="100dp"
        android:layout_height="0.5dp"
        android:layout_marginRight="2dp"
        android:layout_marginBottom="2dp"
        android:layout_below="@+id/txtValue"
        android:layout_alignParentRight="true"/>
    <View
        android:orientation="horizontal"
        android:id="@+id/lineBarValueX"
        android:background="@color/white_alpha_2"
        android:layout_width="50dp"
        android:layout_height="1dp"
        android:layout_alignLeft="@+id/lineBarBgX"
        android:layout_alignTop="@+id/lineBarBgX"
        android:layout_alignBottom="@+id/lineBarBgX"/>
    <View
        android:orientation="horizontal"
        android:id="@+id/lineBarBgY"
        android:background="@color/white_alpha_3"
        android:layout_width="100dp"
        android:layout_height="0.5dp"
        android:layout_marginRight="2dp"
        android:layout_marginBottom="2dp"
        android:layout_below="@+id/lineBarBgX"
        android:layout_alignParentRight="true"/>
    <View
        android:orientation="horizontal"
        android:id="@+id/lineBarValueY"
        android:background="@color/white_alpha_2"
        android:layout_width="50dp"
        android:layout_height="1dp"
        android:layout_alignLeft="@+id/lineBarBgY"
        android:layout_alignTop="@+id/lineBarBgY"
        android:layout_alignBottom="@+id/lineBarBgY"/>
    <RelativeLayout
        android:id="@+id/elementDetailContent"
        android:padding="6dp"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="0dp"
        android:layout_below="@+id/title"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/controlsX"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.daaw.avee.comp.Common.View.InfiniteSeekBar
                android:id="@+id/iSeekBarX"
                android:visibility="visible"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:progress="0"
                android:layout_weight="1"/>
            <androidx.appcompat.widget.AppCompatEditText
                android:textSize="@dimen/textSizeM1"
                android:textColor="@color/white_alpha_2"
                android:id="@+id/iEditTxt"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="0dp"
                android:inputType="numberDecimal"
                android:layout_marginStart="0dp"
                android:layout_marginEnd="0dp"
                app:backgroundTint="@color/white_alpha_2"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/controlsY"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/controlsX">
            <com.daaw.avee.comp.Common.View.InfiniteSeekBar
                android:id="@+id/iSeekBarY"
                android:visibility="visible"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:progress="0"
                android:layout_weight="1"/>
            <androidx.appcompat.widget.AppCompatEditText
                android:textSize="@dimen/textSizeM1"
                android:textColor="@color/white_alpha_2"
                android:id="@+id/editTxtY"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="0dp"
                android:inputType="numberDecimal"
                android:layout_marginStart="0dp"
                android:layout_marginEnd="0dp"
                app:backgroundTint="@color/white_alpha_2"/>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
