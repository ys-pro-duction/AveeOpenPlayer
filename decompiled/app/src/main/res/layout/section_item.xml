<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="?attr/containerBackgroundDark"
    android:padding="0dp"
    android:layout_width="match_parent"
    android:layout_height="@dimen/design_height_0">
    <View
        android:background="@color/gray_2"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_alignParentTop="true"/>
    <TextView
        android:textSize="@dimen/textSizeM0"
        android:textColor="?attr/containerFG"
        android:gravity="center"
        android:id="@+id/txtTitle"
        android:paddingLeft="16dp"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/design_height_0"
        android:text=""
        android:singleLine="true"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true"/>
    <ImageButton
        android:id="@+id/btnCollapse"
        android:background="?android:attr/selectableItemBackground"
        android:padding="0dp"
        android:layout_width="@dimen/design_height_0"
        android:layout_height="match_parent"
        android:src="@drawable/ic_minus"
        android:tint="?attr/containerFGw"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:color="@color/text_color_m2"/>
</RelativeLayout>
