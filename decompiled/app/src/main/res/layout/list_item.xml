<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/viewItemBg"
    android:background="?attr/listItemBackground"
    android:paddingLeft="0dp"
    android:paddingTop="0dp"
    android:paddingRight="0dp"
    android:paddingBottom="0dp"
    android:layout_width="match_parent"
    android:layout_height="@dimen/design_height_0"
    android:foreground="?android:attr/selectableItemBackground">
    <RelativeLayout
        android:id="@+id/artNumGroup"
        android:paddingLeft="0dp"
        android:paddingTop="0dp"
        android:paddingRight="0dp"
        android:paddingBottom="0dp"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true">
        <TextView
            android:textSize="@dimen/textSizeM1"
            android:textColor="?attr/containerFGw"
            android:ellipsize="start"
            android:id="@+id/txtNum"
            android:paddingLeft="6dp"
            android:paddingRight="2dp"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:singleLine="true"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"/>
        <ImageView
            android:id="@+id/imgArt"
            android:padding="0dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:scaleType="centerInside"
            android:tint="?attr/containerFG"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <ImageButton
        android:id="@+id/btnItemMore"
        android:background="?android:attr/selectableItemBackground"
        android:padding="0dp"
        android:layout_width="48dp"
        android:layout_height="match_parent"
        android:src="@drawable/ic_overflowv_2_s"
        android:tint="?attr/containerBackgroundDark"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:color="@color/black"/>
    <TextView
        android:textSize="@dimen/textSizeM2"
        android:textColor="?attr/containerFGw"
        android:id="@+id/txtItemDuration"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:singleLine="true"
        android:layout_toLeftOf="@+id/btnItemMore"
        android:layout_centerVertical="true"
        android:layout_alignWithParentIfMissing="true"/>
    <RelativeLayout
        android:paddingLeft="0dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toLeftOf="@+id/txtItemDuration"
        android:layout_toRightOf="@+id/artNumGroup"
        android:layout_centerVertical="true"
        android:layout_alignWithParentIfMissing="true">
        <TextView
            android:textSize="@dimen/textSizeM1"
            android:textColor="?attr/containerFG"
            android:ellipsize="end"
            android:id="@+id/txtItemLine1"
            android:paddingLeft="9dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:singleLine="true"/>
        <TextView
            android:textSize="@dimen/textSizeM2"
            android:textColor="?attr/containerFGw"
            android:ellipsize="end"
            android:id="@+id/txtItemLine2"
            android:paddingLeft="9dp"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:singleLine="true"
            android:layout_below="@+id/txtItemLine1"/>
    </RelativeLayout>
</RelativeLayout>
