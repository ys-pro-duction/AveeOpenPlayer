<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/propertyViewRoot"
    android:background="@drawable/background_round_border"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:alpha="0">
    <ScrollView
        android:padding="0dp"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fadeScrollbars="false">
        <RelativeLayout
            android:orientation="vertical"
            android:id="@+id/tab2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/layoutPropertyContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <ImageButton
                android:id="@+id/btnClose"
                android:background="?android:attr/selectableItemBackground"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginTop="48dp"
                android:src="@drawable/ic_tree_arrow_left_0"
                android:tint="@color/white_alpha_0"
                android:layout_below="@+id/layoutPropertyContent"
                android:layout_centerHorizontal="true"
                android:rotation="-90"/>
        </RelativeLayout>
    </ScrollView>
</LinearLayout>
