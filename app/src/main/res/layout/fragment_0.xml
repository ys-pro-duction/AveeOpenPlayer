<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:recyclerviewfastscroller="http://schemas.android.com/apk/res-auto"
    android:background="?attr/containerBackground"
    android:padding="0dp"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingBottom="@dimen/activity_vertical_margin"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/tabStripPathGroup"
        android:clickable="true"
        android:longClickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">
        <View
            android:id="@+id/viewStatusBarBg"
            android:background="?attr/colorPrimary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/status_bar_height"
            android:layout_alignParentTop="true"/>
        <View
            android:id="@+id/viewActionBarBg"
            android:background="?attr/colorPrimary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/actionbar_height"
            android:layout_below="@+id/viewStatusBarBg"/>
        <View
            android:id="@+id/viewActionBarBgSkin"
            android:background="#00000000"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="@dimen/actionbar_height"
            android:layout_below="@+id/viewStatusBarBg"/>
        <com.astuetz.PagerSlidingTabStrip
            android:id="@+id/tabStripPath"
            android:background="?attr/libraryPathBackground"
            android:layout_width="match_parent"
            android:layout_height="@dimen/design_height_minus_div"
            android:layout_below="@+id/viewActionBarBg"/>
        <View
            android:background="?attr/colorPrimary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/design_height_divider"
            android:layout_below="@+id/tabStripPath"/>
        <View
            android:background="@drawable/actionbar_shadow_2x"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_below="@+id/viewActionBarBg"/>
    </RelativeLayout>
    <View
        android:id="@+id/backSwipeProgressBg"
        android:background="@color/black_alpha_4"
        android:layout_width="match_parent"
        android:layout_height="@dimen/design_height_divider"
        android:layout_alignBottom="@+id/tabStripPathGroup"
        android:layout_alignParentLeft="true"/>
    <View
        android:id="@+id/backSwipeProgress"
        android:background="@color/text_color_m3"
        android:layout_width="match_parent"
        android:layout_height="@dimen/design_height_divider"
        android:layout_alignBottom="@+id/backSwipeProgressBg"
        android:layout_alignParentLeft="true"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/tabStripPathGroup">
        <RelativeLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewItems"
                android:background="@color/transparent"
                android:paddingLeft="0dp"
                android:paddingRight="0dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                recyclerviewfastscroller:fastScrollEnabled="true"
                recyclerviewfastscroller:fastScrollHorizontalThumbDrawable="@drawable/listview_thumb_drawable"
                recyclerviewfastscroller:fastScrollHorizontalTrackDrawable="@drawable/listview_line_drawable"
                recyclerviewfastscroller:fastScrollVerticalThumbDrawable="@drawable/listview_thumb_drawable"
                recyclerviewfastscroller:fastScrollVerticalTrackDrawable="@drawable/listview_line_drawable"/>
        </RelativeLayout>
    </RelativeLayout>
</RelativeLayout>
