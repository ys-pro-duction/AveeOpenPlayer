<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:padding="0dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:orientation="horizontal"
        android:id="@+id/row1Gap"
        android:background="@color/white_alpha_2"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_alignParentTop="true"/>
    <RelativeLayout
        android:id="@+id/groupHeader"
        android:background="@color/white_alpha_4"
        android:padding="0dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:foreground="?android:attr/selectableItemBackground"
        android:layout_below="@+id/row1Gap">
        <ImageView
            android:id="@+id/btnExpand"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_tree_arrow_left_0"
            android:scaleType="center"
            android:tint="@color/white"
            android:layout_alignParentRight="true"
            android:rotation="0"/>
        <TextView
            android:textSize="@dimen/textSizeM2"
            android:textColor="@color/white_alpha_1"
            android:gravity="center_vertical"
            android:id="@+id/groupTitle"
            android:padding="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:layout_toLeftOf="@+id/btnExpand"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/linearLayoutContent"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/groupHeader"/>
</RelativeLayout>
