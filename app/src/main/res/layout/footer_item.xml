<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="?attr/listItemBackground"
    android:padding="0dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include layout="@layout/ad_container"/>
    <RelativeLayout
        android:padding="0dp"
        android:layout_width="match_parent"
        android:layout_height="@dimen/player_controls_height_max">
        <TextView
            android:textSize="@dimen/textSizeM1"
            android:textColor="?attr/containerFG"
            android:gravity="center"
            android:id="@+id/textInfo"
            android:paddingLeft="0dp"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/design_height_0"
            android:text=""
            android:singleLine="true"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="@dimen/textSizeM2"
            android:textColor="?attr/containerFGw"
            android:gravity="center"
            android:id="@+id/textInfoItems"
            android:padding="12dp"
            android:paddingLeft="0dp"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/design_height_0"
            android:text=""
            android:singleLine="true"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
    <View
        android:id="@+id/navbar_placeholder"
        android:layout_width="match_parent"
        android:layout_height="0dp"/>
</LinearLayout>
