<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutMediaControls"
    android:background="#00000000"
    android:paddingLeft="8dp"
    android:paddingTop="0dp"
    android:paddingRight="8dp"
    android:paddingBottom="0dp"
    android:clickable="true"
    android:longClickable="true"
    android:layout_width="match_parent"
    android:layout_height="@dimen/player_controls_height"
    android:layout_alignParentBottom="true">
    <ImageButton
        android:id="@+id/btnVolume"
        android:background="?android:attr/selectableItemBackground"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_speaker_s"
        android:tint="?attr/mediaControlsFG"
        android:layout_alignParentLeft="true"
        android:layout_alignParentBottom="true"
        style="?android:attr/buttonStyleSmall"/>
    <SeekBar
        android:id="@+id/seekBarSongProgress"
        android:paddingLeft="8dp"
        android:paddingTop="0dp"
        android:paddingRight="8dp"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:maxHeight="34dp"
        android:max="1000"
        android:progressDrawable="?attr/songProgressBar"
        android:thumb="@null"
        android:layout_toLeftOf="@+id/txtSongDuration"
        android:layout_toRightOf="@+id/txtSongCurrentTime"/>
    <TextView
        android:textSize="@dimen/textSizeM3"
        android:textColor="?attr/mediaControlsFGw"
        android:gravity="center"
        android:id="@+id/txtSongCurrentTime"
        android:paddingLeft="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00"
        android:layout_toRightOf="@+id/btnVolume"
        android:layout_alignTop="@+id/seekBarSongProgress"
        android:layout_alignBottom="@+id/seekBarSongProgress"/>
    <TextView
        android:textSize="@dimen/textSizeM3"
        android:textColor="?attr/mediaControlsFGw"
        android:gravity="center"
        android:id="@+id/txtSongDuration"
        android:paddingRight="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00"
        android:layout_toLeftOf="@+id/relativeLayout_m2"
        android:layout_alignTop="@+id/seekBarSongProgress"
        android:layout_alignBottom="@+id/seekBarSongProgress"/>
    <TextView
        android:textSize="@dimen/textSizeM1"
        android:textColor="?attr/mediaControlsFG"
        android:gravity="top"
        android:id="@+id/txtSongTitle"
        android:paddingLeft="9dp"
        android:paddingRight="9dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="title"
        android:scrollHorizontally="true"
        android:singleLine="true"
        android:freezesText="true"
        android:layout_alignLeft="@+id/seekBarSongProgress"
        android:layout_alignRight="@+id/seekBarSongProgress"
        android:layout_alignParentTop="true"
        android:marqueeRepeatLimit="marquee_forever"/>
    <ImageButton
        android:id="@+id/btnMediaControlsOverflow"
        android:background="?android:attr/selectableItemBackground"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_overflowh_2_s"
        android:tint="?attr/mediaControlsFG"
        android:minWidth="70dp"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        style="?android:attr/buttonStyleSmall"/>
    <RelativeLayout
        android:id="@+id/relativeLayout_m2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toLeftOf="@+id/btnMediaControlsOverflow"
        android:layout_centerVertical="true">
        <ImageButton
            android:id="@+id/btnPause"
            android:background="?android:attr/selectableItemBackground"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_ctrl_pause_s"
            android:tint="?attr/mediaControlsFG"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            style="?android:attr/buttonStyleSmall"/>
        <ImageView
            android:id="@+id/viewOverlayPause"
            android:padding="8dp"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_ctrl_plring_3_s"
            android:tint="?attr/mediaControlsFG"
            android:layout_alignLeft="@+id/btnPause"
            android:layout_alignTop="@+id/btnPause"
            android:layout_alignRight="@+id/btnPause"
            android:layout_alignBottom="@+id/btnPause"
            android:alpha="0.3"/>
        <ImageButton
            android:id="@+id/btnPrev"
            android:background="?android:attr/selectableItemBackground"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_ctrl_fb"
            android:tint="?attr/mediaControlsFG"
            android:minWidth="70dp"
            android:minHeight="48dp"
            android:layout_toLeftOf="@+id/btnPause"
            android:layout_centerVertical="true"
            style="?android:attr/buttonStyleSmall"/>
        <ImageButton
            android:id="@+id/btnNext"
            android:background="?android:attr/selectableItemBackground"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_ctrl_ff"
            android:tint="?attr/mediaControlsFG"
            android:minWidth="70dp"
            android:layout_toRightOf="@+id/btnPause"
            android:layout_centerVertical="true"
            style="?android:attr/buttonStyleSmall"/>
    </RelativeLayout>
</RelativeLayout>
