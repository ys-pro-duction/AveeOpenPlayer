<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutContentExporting"
    android:background="#0000"
    android:paddingTop="30dp"
    android:paddingBottom="30dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingVertical="30dp">
    <com.google.android.gms.ads.AdView
        android:id="@+id/adView"
        android:background="@color/white"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="250dp"
        android:layout_marginBottom="20dp"
        app:adSize="MEDIUM_RECTANGLE"
        app:adUnitId="@string/ads_export_banner"
        app:layout_constraintBottom_toTopOf="@+id/progressBarRenderGroup"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <com.google.android.gms.ads.AdView
        android:id="@+id/adViewHorizontal"
        android:background="@color/white"
        android:visibility="gone"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        app:adSize="MEDIUM_RECTANGLE"
        app:adUnitId="@string/ads_export_banner"
        app:layout_constraintBottom_toBottomOf="@+id/progressBarRenderGroup"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/progressBarRenderGroup"
        app:layout_constraintTop_toTopOf="@+id/progressBarRenderGroup"/>
    <RelativeLayout
        android:id="@+id/progressBarRenderGroup"
        android:background="@drawable/rounded"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/adViewHorizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/adView"
        app:layout_constraintWidth_max="300dp">
        <ProgressBar
            android:id="@+id/progressBarRender"
            android:background="@drawable/circular_progress_bar_bg"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:max="1000"
            android:progress="0"
            android:indeterminate="false"
            android:progressDrawable="@drawable/circular_progress_bar"
            android:layout_centerInParent="true"
            style="?android:attr/progressBarStyleHorizontal"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">
            <TextView
                android:textSize="@dimen/textSizeM3"
                android:ellipsize="end"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/txtRender"
                android:padding="0dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAlignment="center"/>
            <TextView
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textSize="@dimen/textSizeM_0"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/txtRenderValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAlignment="center"/>
        </LinearLayout>
        <ImageButton
            android:id="@+id/btnStopExport"
            android:background="?android:attr/selectableItemBackground"
            android:padding="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_close"
            android:tint="?attr/containerFG"
            android:layout_alignBottom="@+id/progressBarRender"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
