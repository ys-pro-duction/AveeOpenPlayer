<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape
            android:shape="ring"
            android:innerRadiusRatio="4"
            android:useLevel="false"
            android:thickness="0.1dp">
            <gradient
                android:startColor="#00000000"
                android:endColor="#8affffff"
                android:useLevel="false"
                android:angle="0"
                android:type="sweep"
                android:centerColor="#45ffffff"/>
            <padding
                android:left="0dp"
                android:top="0dp"
                android:right="0dp"
                android:bottom="0dp"/>
        </shape>
    </item>
</layer-list>
